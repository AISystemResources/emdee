{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "main": true,
      "feat/*": true,
      "agent/*": false,
      "agents": false,
      "dev": false
    }
  },
  "crons": [
    {
      "path": "/api/cron/auto-heal-namespaces",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/weekly-reconcile-all",
      "schedule": "30 3 * * 0"
    }
  ]
}
