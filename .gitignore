# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report
/test-results
/blob-report
/playwright/.cache

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
*.log

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Claude Code agent workspaces — ignore local settings, keep shared config
.claude/*
!.claude/commands/
!.claude/commands/**

# Supabase CLI temp files (version snapshots, pooler URL, etc.)
supabase/.temp/

# Private knowledge — the structure is in templates/, the contents are yours.
# Anchored to repo root so it doesn't shadow other "docs" directories
# (e.g. app/api/rest/docs/).
/docs/
!/docs/.gitkeep

# SPRINT-129: pre-compiled CLI bundles (rebuilt on npm publish)
dist/
OCC-RACE-*.png
